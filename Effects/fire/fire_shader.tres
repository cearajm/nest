code = "shader_type spatial;
render_mode blend_mix, depth_draw_opaque, depth_test_default, cull_back, diffuse_lambert, specular_schlick_ggx, unshaded;

uniform vec2 Vector2Parameter;
uniform sampler2D tex_frg_7;
uniform sampler2D tex_frg_15;
uniform sampler2D tex_frg_2;



void vertex() {
	mat4 n_out2p0;
// GetBillboardMatrix:2
	{
		mat4 __mvm = VIEW_MATRIX * mat4(INV_VIEW_MATRIX[0], MODEL_MATRIX[1], vec4(normalize(cross(INV_VIEW_MATRIX[0].xyz, MODEL_MATRIX[1].xyz)), 0.0), MODEL_MATRIX[3]);
		__mvm = __mvm * mat4(vec4(1.0, 0.0, 0.0, 0.0), vec4(0.0, 1.0 / length(MODEL_MATRIX[1].xyz), 0.0, 0.0), vec4(0.0, 0.0, 1.0, 0.0), vec4(0.0, 0.0, 0.0, 1.0));
		n_out2p0 = __mvm;
	}


// Output:0
	MODELVIEW_MATRIX = n_out2p0;


}

void fragment() {
// Input:8
	vec2 n_out8p0 = UV;


// Input:13
	float n_out13p0 = TIME;


// Vector2Parameter:19
	vec2 n_out19p0 = Vector2Parameter;


// VectorOp:14
	vec2 n_out14p0 = vec2(n_out13p0) * n_out19p0;


// UVFunc:12
	vec2 n_in12p1 = vec2(1.00000, 1.00000);
	vec2 n_out12p0 = n_out14p0 * n_in12p1 + UV;


// Texture2D:7
	vec4 n_out7p0 = texture(tex_frg_7, n_out12p0);


// VectorDecompose:10
	float n_out10p0 = n_out7p0.x;
	float n_out10p1 = n_out7p0.y;
	float n_out10p2 = n_out7p0.z;
	float n_out10p3 = n_out7p0.w;


// FloatOp:11
	float n_in11p1 = 4.00000;
	float n_out11p0 = n_out10p0 / n_in11p1;


// Texture2D:15
	vec4 n_out15p0 = texture(tex_frg_15, UV);


// VectorDecompose:17
	float n_out17p0 = vec3(n_out15p0.xyz).x;
	float n_out17p1 = vec3(n_out15p0.xyz).y;
	float n_out17p2 = vec3(n_out15p0.xyz).z;


// VectorOp:16
	vec2 n_out16p0 = vec2(n_out11p0) * vec2(n_out17p0);


// VectorOp:9
	vec4 n_out9p0 = vec4(n_out8p0, 0.0, 0.0) + vec4(n_out16p0, 0.0, 0.0);


// Texture2D:2
	vec4 n_out2p0 = texture(tex_frg_2, vec2(n_out9p0.xy));


// Input:18
	vec4 n_out18p0 = COLOR;


// VectorOp:5
	vec4 n_out5p0 = n_out2p0 * n_out18p0;


// VectorDecompose:6
	float n_out6p0 = n_out2p0.x;
	float n_out6p1 = n_out2p0.y;
	float n_out6p2 = n_out2p0.z;
	float n_out6p3 = n_out2p0.w;


// Output:0
	ALBEDO = vec3(n_out5p0.xyz);
	ALPHA = n_out6p0;


}
"
